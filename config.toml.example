# 复制为 config.toml 后按部署修改。运行时状态仍写在各插件的 data/ 下。

[network]
# 拦截非公网地址并做 DNS pinning。默认关闭，以兼容经本地代理转发的部署。
# 若同时设置环境变量 PRIVATE_NETWORK_PROTECTION，以环境变量为准。
private_network_protection = false

[ocr]
# 腾讯云 OCR。两项都填写后才会识别图片文字。
secret_id = ""
secret_key = ""

[msg_rank]
retention_days = 8
wordcloud_concurrency = 1

[[msg_rank.wordcloud]]
cron = "0 21 * * *"
days = 1
title = "今日词云"

[[msg_rank.wordcloud]]
cron = "0 10 * * 6"
days = 7
title = "上周词云"

[image_lib]
# 每个群的图库总容量上限，单位 MiB（1 MiB = 1024 KiB）。
max_group_mib = 500
# 单张图片大小上限，单位 MiB。
max_image_mib = 15
# 「来只」滑动窗口限流：窗口长度（秒）和窗口内最多抽取次数。
draw_window_secs = 60
draw_max_per_window = 5
