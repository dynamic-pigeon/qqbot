# bilibili 动态订阅默认自动使用游客身份，无需配置 cookie。
# 如需覆盖自动游客会话，可从浏览器取 buvid3、b_nut、SESSDATA 等字段。
# 例如: BILIBILI_COOKIE="buvid3=xxx; b_nut=yyy"
BILIBILI_COOKIE=

# 私网保护默认关闭，以兼容流量经本地代理或劫持地址转发的部署环境。
# 优先改根目录 config.toml 的 [network] private_network_protection。
# 本变量若设置则覆盖 config.toml。
PRIVATE_NETWORK_PROTECTION=false
